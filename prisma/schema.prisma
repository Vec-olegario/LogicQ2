// ============================================================================
// LogiQ — Schema do banco de dados (Neon Postgres + Prisma)
// ============================================================================
// Contexto: WMS didático onde alunos ocupam "slots" temporários por equipe
// (sem login tradicional) e operam um fluxo logístico simulado
// (Recebimento -> Estoque -> Picking -> Expedição).
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  // Use a connection string com pooling do Neon (contém "-pooler" no host).
  // Isso é essencial em ambiente serverless (Vercel) para não esgotar
  // conexões, já que cada função pode abrir sua própria conexão.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// Equipe — a "turma" que usa o sistema. Tabela pai de Slots e Turnos.
// ----------------------------------------------------------------------------
model Equipe {
  id        String   @id @default(cuid())
  nome      String   @unique
  cor       String   @default("blue")
  criadoEm  DateTime @default(now())

  slots    Slot[]
  turnos   Turno[]
  usuarios Usuario[] // Adicionado relação com Usuario

  @@map("equipes")
}

// ----------------------------------------------------------------------------
// Slot — vaga fixa dentro de uma equipe (ex: "Recebimento", "Picking").
// Não existe cadastro de usuário: o aluno apenas ocupa um slot já existente
// e define um nome de exibição. O slot expira sozinho depois de um tempo.
// ----------------------------------------------------------------------------
model Slot {
  id          String    @id @default(cuid())
  equipeId    String
  equipe      Equipe    @relation(fields: [equipeId], references: [id], onDelete: Cascade)

  papel       String    // Ex: "Líder", "Recebimento", "Estoque", "Picking", "Expedição"
  nomeDisplay String?   // Nome exibido (agora vindo do Usuario ocupante)
  ocupado     Boolean   @default(false)
  ocupadoEm   DateTime?
  expiraEm    DateTime? // Calculado no momento da ocupação (ocupadoEm + duração)
  
  usuarioId   String?   @unique // Um usuário só pode ocupar um slot por vez? Na verdade, se o slot é único por usuário, usamos @unique, mas um slot só tem 1 usuário.
  usuario     Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  // Garante que não existam dois slots com o mesmo papel na mesma equipe.
  // Também acelera a busca "slot de tal papel nesta equipe".
  @@unique([equipeId, papel])
  @@map("slots")
}

// ----------------------------------------------------------------------------
// Usuario — o aluno da turma. A "conta" é atrelada à equipe.
// ----------------------------------------------------------------------------
model Usuario {
  id        String   @id @default(cuid())
  nome      String
  isLider   Boolean  @default(false)
  criadoEm  DateTime @default(now())

  equipeId  String
  equipe    Equipe   @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  
  slotAtual Slot?

  // Não podem existir dois alunos com o mesmo nome na mesma equipe
  @@unique([equipeId, nome])
  @@map("usuarios")
}

// ----------------------------------------------------------------------------
// Turno — uma sessão prática ativa de uma equipe. Guarda o placar de
// acurácia do picking daquela sessão. Sempre deve existir no máximo um
// turno com ativo=true por equipe (regra aplicada na Server Action, não
// no schema, já que Prisma não suporta unique parcial nativamente aqui).
// ----------------------------------------------------------------------------
model Turno {
  id             String   @id @default(cuid())
  equipeId       String
  equipe         Equipe   @relation(fields: [equipeId], references: [id], onDelete: Cascade)

  ativo          Boolean  @default(true)
  acertosPicking Int      @default(0)
  errosPicking   Int      @default(0)
  iniciadoEm     DateTime @default(now())

  // Metas do Turno
  titulo         String   @default("Operação Padrão")
  contexto       String   @default("Fluxo normal do dia a dia.")
  exigirSkuExato Boolean  @default(true)
  metaAcuracia   Int      @default(98)
  metaErros      Int      @default(0)
  metaItensDesc  String   @default("Fluxo Contínuo")
  dificuldade    String   @default("Normal")
  tempoSLA       Int      @default(5)
  metaVolume     Int      @default(500)

  itens Item[]

  // Acelera a busca do "turno ativo" de uma equipe.
  @@index([equipeId, ativo])
  @@map("turnos")
}

// ----------------------------------------------------------------------------
// StatusItem — enum nativo do Prisma (em vez de string solta) para dar
// segurança de tipo no TypeScript e evitar valores inválidos no banco.
// ----------------------------------------------------------------------------
enum StatusItem {
  RECEBIDO
  ESTOCADO
  SEPARADO
  EXPEDIDO
}

// ----------------------------------------------------------------------------
// Item — a "caixa logística" que percorre o fluxo do armazém dentro de
// um turno específico. Cada turno tem seu próprio conjunto de itens.
// ----------------------------------------------------------------------------
model Item {
  id          String     @id @default(cuid())
  turnoId     String
  turno       Turno      @relation(fields: [turnoId], references: [id], onDelete: Cascade)

  codigo      String     // EAN/SKU
  descricao   String
  quantidade  Int
  fornecedor  String
  status      StatusItem @default(RECEBIDO)
  posicao     String?    // Ex: "Rua A, Nível 2" — definida ao endereçar (ESTOCADO)
  docaSaida   String?    // Definida ao expedir

  criadoEm    DateTime   @default(now())

  // Acelera buscas por código de barras (usadas no picking/bipagem).
  @@index([codigo])
  @@map("itens")
}

// ----------------------------------------------------------------------------
// ConfiguracaoGlobal — Configurações globais para as metas da sala de aula.
// Utilizada como padrão para novos turnos e para sincronização.
// ----------------------------------------------------------------------------
model ConfiguracaoGlobal {
  id             String   @id @default("global") // Haverá apenas 1 registro com ID "global"
  
  titulo         String   @default("Operação Padrão")
  contexto       String   @default("Fluxo normal do dia a dia.")
  exigirSkuExato Boolean  @default(true)

  metaAcuracia   Int      @default(98)
  metaErros      Int      @default(0)
  metaItensDesc  String   @default("Fluxo Contínuo")
  dificuldade    String   @default("Normal")
  tempoSLA       Int      @default(5)
  metaVolume     Int      @default(500)
  
  itensEsperados ItemEsperado[]

  atualizadoEm   DateTime @updatedAt
  
  @@map("configuracao_global")
}

// ----------------------------------------------------------------------------
// ItemEsperado — a "Nota Fiscal" esperada para a situação de aprendizagem atual
// ----------------------------------------------------------------------------
model ItemEsperado {
  id             String   @id @default(cuid())
  configuracaoId String
  configuracao   ConfiguracaoGlobal @relation(fields: [configuracaoId], references: [id], onDelete: Cascade)

  codigo         String     // EAN/SKU
  descricao      String
  quantidade     Int
  fornecedor     String

  criadoEm       DateTime   @default(now())

  @@map("itens_esperados")
}
